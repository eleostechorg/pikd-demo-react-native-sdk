{
  "name": "pikd-react-native-demo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint App.tsx src test/*.tsx && prettier --check App.tsx src test tools",
    "start": "react-native start",
    "test": "npm run prepare:config && jest --runInBand --watchman=false",
    "prepare:config": "node tools/prepare-config.cjs",
    "prestart": "npm run prepare:config",
    "preandroid": "npm run prepare:config",
    "preios": "npm run prepare:config",
    "typecheck": "tsc --noEmit",
    "bundle:ios": "npm run prepare:config && react-native bundle --platform ios --entry-file index.js --dev false --bundle-output build/index.ios.jsbundle --assets-dest build/ios",
    "bundle:android": "npm run prepare:config && react-native bundle --platform android --entry-file index.js --dev false --bundle-output build/index.android.jsbundle --assets-dest build/android",
    "run:android": "bash scripts/run-android.sh",
    "run:ios": "bash scripts/run-ios.sh",
    "test:runners": "node --test tools/test-runners.cjs"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-native": "0.80.2",
    "@eleostechorg/pikd-react-native-core": "0.8.0-beta.15",
    "@eleostechorg/pikd-react-native-ui": "0.8.0-beta.15",
    "@eleostechorg/pikd-react-native-experience": "0.8.0-beta.15",
    "@eleostechorg/pikd-react-native-partner-experience": "0.8.0-beta.15",
    "@eleostechorg/pikd-react-native-ar": "0.8.0-beta.15",
    "react-native-maps": "1.26.0",
    "react-native-svg": "15.15.0",
    "lottie-react-native": "7.3.4",
    "react-native-linear-gradient": "2.8.3",
    "react-native-render-html": "6.3.4",
    "@react-native-community/blur": "4.4.1",
    "@somesoap/react-native-image-palette": "1.2.2",
    "@react-native-community/geolocation": "3.4.0",
    "react-native-permissions": "5.4.4",
    "react-native-safe-area-context": "5.6.2",
    "react-native-url-polyfill": "4.0.0",
    "@callstack/liquid-glass": "0.7.0",
    "react-native-get-random-values": "1.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "19.1.1",
    "@react-native-community/cli-platform-android": "19.1.1",
    "@react-native-community/cli-platform-ios": "19.1.1",
    "@react-native/babel-preset": "0.80.2",
    "@react-native/metro-config": "0.80.2",
    "@react-native/typescript-config": "0.80.2",
    "@types/jest": "^29.5.13",
    "@types/react": "19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "10.11.0",
    "jest": "29.7.0",
    "prettier": "3.9.9",
    "react-test-renderer": "19.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/eleostechorg/pikd-demo-react-native-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/eleostechorg/pikd-demo-react-native-sdk/issues"
  },
  "homepage": "https://www.pikd.app"
}
